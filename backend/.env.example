# Optional backend provider keys. Empty values keep the app on its local
# fallback paths; configure only services you intend to use.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# SQLite is the local default. Supabase storage additionally requires the
# service key and the SQL schema/migration in supabase_schema.sql.
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Local default avoids loading large ML models. For routing, install the
# full stack and set LITE_MODE=false after building the graph.
LITE_MODE=true
RAG_DISABLED=true
ENABLE_BENGALI_EMBEDDER=false
GRAPH_PATH=data/chittagong_walk.graphml
CHROMA_PATH=./chroma_store

ALLOWED_ORIGINS=http://localhost:5173
SAFEHER_SECRET_KEY=change-me
SAFEHER_PASSWORD_SALT=change-me

# Leave blank to disable the authenticated SMTP fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
